rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Ping / Health check para verificação de conectividade
    match /_health_check_/{docId} {
      allow read, write: if true;
    }

    // Perfis de usuários e operadores (coleções users e usuarios)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /usuarios/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Estabelecimentos e pistas
    match /tenants/{tenantId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Veículos da frota
    match /veiculos/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Corridas, aluguéis e histórico
    match /corridas/{rentalId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Fila de espera
    match /fila/{queueId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Fallback padrão seguro para quaisquer outros documentos
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
