rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura e escrita completa para o app Drift Park
    // O isolamento multi-tenant por empresa/unidade é gerido e garantido
    // estritamente pelas coleções e pelo tenantId no código do app.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
