rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // REGRAS DE SEGURANÇA FIRESTORE - AUTENTICAÇÃO E MULTI-TENANT
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // Coleções de Usuários: permite leitura e gravação para usuários autenticados
    // Salvando email, perfil, tenantId e adminEmail do administrador vinculado
    match /usuarios/{userId} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // Frota de Veículos
    match /veiculos/{veiculoId} {
      allow read, write: if isSignedIn();
    }

    // Corridas e Aluguéis
    match /corridas/{corridaId} {
      allow read, write: if isSignedIn();
    }

    // Clientes
    match /clientes/{clienteId} {
      allow read, write: if isSignedIn();
    }

    // Caixa & Financeiro
    match /caixa/{caixaId} {
      allow read, write: if isSignedIn();
    }

    // Fila de Espera
    match /fila/{filaId} {
      allow read, write: if isSignedIn();
    }

    // Regra padrão para demais documentos
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
